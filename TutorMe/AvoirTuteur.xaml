<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorMe.AvoirTuteur">

    <ContentPage.Background>
        <LinearGradientBrush>
            <GradientStop Offset="0.1" Color="#274472"/>

            <GradientStop Offset="1.0" Color="#41729F"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Border StrokeShape="RoundRectangle 40,40,40,40" WidthRequest="530" HeightRequest="1000">
            <VerticalStackLayout
            Padding="70"
            Spacing="25">
                <Label Text="AVOIR UN TUTEUR" FontSize="50" TextColor="White" HorizontalTextAlignment="Center"  FontFamily="KG" />


                <Entry StyleClass="entry" x:Name="newPerson"
                Placeholder="Entrez votre nom" FontFamily="KG" PlaceholderColor="Black"  FontSize="30" HeightRequest="50" WidthRequest="400"/>

                <Entry x:Name="Prenom"
                Placeholder="Veuillez indiquer votre prénom"  PlaceholderColor="Black" FontFamily="KG" FontSize="30" HeightRequest="50" WidthRequest="400"/>

                <Entry x:Name="DA"
                Placeholder="Veuillez indiquer votre DA" FontFamily="KG" PlaceholderColor="Black" FontSize="30" HeightRequest="50" WidthRequest="400"/>

                <Label
                Text="Veuillez indiquer vos trois disponibilités (le plus préférable au moins préférable)"
                SemanticProperties.HeadingLevel="Level1" FontFamily="KG" VerticalOptions="FillAndExpand" FontSize="20" HeightRequest="60" WidthRequest="600" />

                <StackLayout Orientation="Horizontal" Spacing="10"  HorizontalOptions="Center" >
                    <!-- Jour -->
                    <Label  VerticalOptions="Center" />
                    <Picker x:Name="pickerJour1" Title="Choisissez le jour" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Lundi</x:String>
                                <x:String>Mardi</x:String>
                                <x:String>Mercredi</x:String>
                                <x:String>Jeudi</x:String>
                                <x:String>Vendredi</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>



                    <Picker x:Name="pickerHeureDebut1" Title="Choisissez l'heure" VerticalOptions="Center" FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>8</x:Int32>
                                <x:Int32>9</x:Int32>
                                <x:Int32>10</x:Int32>
                                <x:Int32>11</x:Int32>
                                <x:Int32>12</x:Int32>
                                <x:Int32>13</x:Int32>
                                <x:Int32>14</x:Int32>
                                <x:Int32>15</x:Int32>
                                <x:Int32>16</x:Int32>
                                <x:Int32>17</x:Int32>
                                <x:Int32>18</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Picker x:Name="pickerHeureFin1" Title="Choisissez l'heure" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>8</x:Int32>
                                <x:Int32>9</x:Int32>
                                <x:Int32>10</x:Int32>
                                <x:Int32>11</x:Int32>
                                <x:Int32>12</x:Int32>
                                <x:Int32>13</x:Int32>
                                <x:Int32>14</x:Int32>
                                <x:Int32>15</x:Int32>
                                <x:Int32>16</x:Int32>
                                <x:Int32>17</x:Int32>
                                <x:Int32>18</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>


                </StackLayout>
                <StackLayout Orientation="Horizontal" Spacing="10"  HorizontalOptions="Center" >
                    <!-- Jour -->
                    <Label  VerticalOptions="Center" />
                    <Picker x:Name="pickerJour2" Title="Choisissez le jour" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Lundi</x:String>
                                <x:String>Mardi</x:String>
                                <x:String>Mercredi</x:String>
                                <x:String>Jeudi</x:String>
                                <x:String>Vendredi</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>


                    <Label  VerticalOptions="Center" />
                    <Picker x:Name="pickerHeureDebut2" Title="Choisissez l'heure" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>8</x:Int32>
                                <x:Int32>9</x:Int32>
                                <x:Int32>10</x:Int32>
                                <x:Int32>11</x:Int32>
                                <x:Int32>12</x:Int32>
                                <x:Int32>13</x:Int32>
                                <x:Int32>14</x:Int32>
                                <x:Int32>15</x:Int32>
                                <x:Int32>16</x:Int32>
                                <x:Int32>17</x:Int32>
                                <x:Int32>18</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Label  VerticalOptions="Center" />
                    <Picker x:Name="pickerHeureFin2" Title="Choisissez l'heure" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>8</x:Int32>
                                <x:Int32>9</x:Int32>
                                <x:Int32>10</x:Int32>
                                <x:Int32>11</x:Int32>
                                <x:Int32>12</x:Int32>
                                <x:Int32>13</x:Int32>
                                <x:Int32>14</x:Int32>
                                <x:Int32>15</x:Int32>
                                <x:Int32>16</x:Int32>
                                <x:Int32>17</x:Int32>
                                <x:Int32>18</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>


                </StackLayout>
                <StackLayout Orientation="Horizontal" Spacing="10"  HorizontalOptions="Center">
                    <!-- Jour -->
                    <Label  VerticalOptions="Center" />
                    <Picker x:Name="pickerJour3" Title="Choisissez le jour" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Lundi</x:String>
                                <x:String>Mardi</x:String>
                                <x:String>Mercredi</x:String>
                                <x:String>Jeudi</x:String>
                                <x:String>Vendredi</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>


                    <Label  VerticalOptions="Center" />
                    <Picker x:Name="pickerHeureDebut3" Title="Choisissez l'heure" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>8</x:Int32>
                                <x:Int32>9</x:Int32>
                                <x:Int32>10</x:Int32>
                                <x:Int32>11</x:Int32>
                                <x:Int32>12</x:Int32>
                                <x:Int32>13</x:Int32>
                                <x:Int32>14</x:Int32>
                                <x:Int32>15</x:Int32>
                                <x:Int32>16</x:Int32>
                                <x:Int32>17</x:Int32>
                                <x:Int32>18</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                    <Label VerticalOptions="Center" />
                    <Picker x:Name="pickerHeureFin3" Title="Choisissez l'heure" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>8</x:Int32>
                                <x:Int32>9</x:Int32>
                                <x:Int32>10</x:Int32>
                                <x:Int32>11</x:Int32>
                                <x:Int32>12</x:Int32>
                                <x:Int32>13</x:Int32>
                                <x:Int32>14</x:Int32>
                                <x:Int32>15</x:Int32>
                                <x:Int32>16</x:Int32>
                                <x:Int32>17</x:Int32>
                                <x:Int32>18</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>


                </StackLayout>
                <StackLayout Orientation="Horizontal" Spacing="10"  HorizontalOptions="Center">
                    <Label  VerticalOptions="Center" />
                    <Picker x:Name="pickerCours" Title="Choisissez votre cours de francais actuel" VerticalOptions="Center"  FontFamily="KG" FontSize="20" TextColor="Black">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:Int32}">
                                <x:Int32>1</x:Int32>
                                <x:Int32>2</x:Int32>
                                <x:Int32>3</x:Int32>
                                <x:Int32>4</x:Int32>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </StackLayout>

                <Entry x:Name="texte"
                Placeholder="Veuillez écrire un texte pour vérifier votre français." HorizontalTextAlignment="Center" PlaceholderColor="Black" FontSize="20" FontFamily="KG" HeightRequest="100" WidthRequest="400" TextColor="Black" />

                <Button Text="Envoyer votre candidature"
                Grid.Row="1"
                Clicked="saveButton_Clicked"   HeightRequest="50" WidthRequest="300" BackgroundColor="Black" FontFamily="KG"/>

                <Label x:Name="statusMessage"
                TextColor="{StaticResource Primary}"
                Grid.Row="2" />



                <CollectionView x:Name="peopleList" Grid.Row="4">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,2*">
                                <Label Text="{Binding Id}" TextColor="{StaticResource Primary}"/>
                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="{StaticResource Primary}"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>
    </ScrollView>

</ContentPage>
