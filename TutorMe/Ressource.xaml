<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorMe.Ressource">


    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="Voici quelques ressources pour vous aider"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"  FontSize="50" HeightRequest="50" WidthRequest="800" FontFamily="KG" />
            <Label Text="Francais, Mathématique, Chimie, Phylosophie etc.."   FontSize="50" HeightRequest="50" WidthRequest="1000" FontFamily="KG" Margin="60"/>
            <Label Text="ALLOPROF" TextColor="Red"   FontSize="50" FontFamily="KG" Margin="50"></Label>

           

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>


