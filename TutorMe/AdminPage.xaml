<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorMe.AdminPage"
             Title="AdminPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button Text="Sign Out" Clicked="SignOut_Clicked" HeightRequest="50" WidthRequest="120" CornerRadius="20" BackgroundColor="blue" Margin="1000,15,0,0"/>
        <Button Text="Show" Clicked="LoadHorairesButton_Clicked" HeightRequest="50" WidthRequest="120" CornerRadius="20" BackgroundColor="blue"/>
        <Button Text="Matched" Clicked="MatchButton_Clicked" HeightRequest="50" WidthRequest="120" CornerRadius="20" BackgroundColor="blue" Margin="0,15,0,0"/>

        <BoxView HeightRequest="20" />

        <!-- Label pour afficher les informations -->
        <Label x:Name="infoLabel" Text="Espace pour les informations" />

        <!-- Ajoutez un espace vertical -->
        <BoxView HeightRequest="20" />
    </VerticalStackLayout>
</ContentPage>