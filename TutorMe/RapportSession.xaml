<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorMe.RapportSession">
    
    <ContentPage.Background>
        <LinearGradientBrush>
            <GradientStop Offset="0.1" Color="#274472"/>

            <GradientStop Offset="1.0" Color="#41729F"/>
        </LinearGradientBrush>
    </ContentPage.Background>


    <ScrollView>
        <Border StrokeShape="RoundRectangle 40,40,40,40" WidthRequest="400" HeightRequest="800">
            <VerticalStackLayout
                Margin="20"
            Padding="30,0"
            Spacing="25">
                <Label
                Text="ÉVALUATION APRÈS LA SESSION"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" HorizontalOptions="FillAndExpand" TextColor="Black" HeightRequest="70" WidthRequest="300" FontFamily="KG"/>

                <Entry x:Name="nomTuteur"
                Placeholder="Nom du tuteur" HorizontalOptions="FillAndExpand" HeightRequest="50" WidthRequest="300" FontFamily="KG"/>

                <Entry x:Name="nomEleve"
                Placeholder="Nom de l'élève" HorizontalOptions="FillAndExpand" HeightRequest="50" WidthRequest="300" FontFamily="KG"/>

                <Entry x:Name="NoteAvantSession"
                Placeholder="Indiquez la note avant les séances" HorizontalOptions="FillAndExpand" HeightRequest="50" WidthRequest="300" FontFamily="KG"/>

                <Entry x:Name="NoteApresSession"
                Placeholder="Indiquez la note après les séances" HorizontalOptions="FillAndExpand" HeightRequest="50" WidthRequest="300" FontFamily="KG"/>

                <Entry x:Name="Session"
                Placeholder="Session : " HorizontalOptions="FillAndExpand" HeightRequest="50" WidthRequest="300" FontFamily="KG" />

                <Entry x:Name="Cours"
                Placeholder="Cours" HorizontalOptions="FillAndExpand" HeightRequest="50" WidthRequest="300" FontFamily="KG"/>

                <Entry x:Name="commentaireTuteur"
                Placeholder="Commentaire : " HorizontalOptions="FillAndExpand" HeightRequest="60" WidthRequest="300" FontFamily="KG"/>

                <Button Text="Envoyer le rapport"
	            Grid.Row="1"
	            Clicked="save_Rapport" HorizontalOptions="FillAndExpand" BackgroundColor="Black" HeightRequest="50" WidthRequest="300" FontFamily="KG" />

            </VerticalStackLayout>
        </Border>
    </ScrollView>

</ContentPage>


