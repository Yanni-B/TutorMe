<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorMe.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout Spacing="25" Padding="30,0" VerticalOptions ="Center">

        <VerticalStackLayout Spacing="5">
            <Label Text="Welcome" FontSize="28" TextColor="Gray" HorizontalTextAlignment="Center" />
            <Label Text="Login to your account" FontSize="18" TextColor="Gray" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <StackLayout Orientation="Horizontal">
           
            <Frame HorizontalOptions="FillAndExpand" HeightRequest="90" WidthRequest="300">
                <Entry x:Name="username" VerticalOptions="Center" Placeholder="Username" Keyboard="Email" />
                

            </Frame>
            
        </StackLayout>


        <StackLayout Orientation="Horizontal">

            <Frame HorizontalOptions="FillAndExpand" HeightRequest="90" WidthRequest="300">
                <Entry x:Name="password" VerticalOptions="Center" Placeholder="Password" IsPassword="True" Keyboard="Email"/>
                

            </Frame>

        </StackLayout>

        <Button Text="Login" HeightRequest="10" WidthRequest="300" BackgroundColor="Blue" CornerRadius="20" Clicked="OnLoginButtonClicked"/>

        <Label Text="Register Now" FontSize="16" TextColor="Blue" HorizontalOptions="Center" VerticalOptions="CenterAndExpand" Margin="0,20,0,0" >
            <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRegisterNowTapped"/>
            </Label.GestureRecognizers>
        </Label>


    </VerticalStackLayout>
</ContentPage>