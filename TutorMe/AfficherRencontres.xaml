<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TutorMe.AfficherRencontres"
             Title="AfficherRencontres">
    <ScrollView>
        <VerticalStackLayout>
        <Label 
            Text="Rencontres futures"
            VerticalOptions="Start" 
            HorizontalOptions="Center" />
        </VerticalStackLayout>
        <Grid>
            <Grid>
                <Label
                    Text="Date"
                    HorizontalOptions="Start"
                    ></Label>
                <Label
                    Text="Heure"
                    HorizontalOptions="End"
                    ></Label>
                <Label
                    Text="Nom de l'autre"
                    HorizontalOptions="End"
                    ></Label>
            </Grid>
        </Grid>
    </ScrollView>
    
</ContentPage>